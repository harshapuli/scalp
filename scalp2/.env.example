# scalp2 / Edge-Centric Trading System v2.2 — environment variables manifest.
# Per spec §10.7. Copy to /etc/trading/secrets.env (chmod 600) and fill in.
# NEVER commit the populated file.

# ──────── DATA APIs ────────
POLYGON_API_KEY=
UW_API_TOKEN=

# ──────── EXECUTION ────────
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets   # flip live-api... after Phase 6

# ──────── STORAGE ────────
POSTGRES_URL=postgresql://trading:changeme@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=trading-fixtures
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ──────── ALERTING ────────
PUSHOVER_USER=
PUSHOVER_TOKEN=
DISCORD_WEBHOOK=                       # optional alternative

# ──────── OPERATIONAL ────────
TRADING_MODE=paper                     # 'paper' | 'ramp_25' | 'ramp_50' | 'full'
MAX_DAILY_LOSS_PCT=-0.020
ENABLE_KILL_SWITCH=true
MODEL_VERSION=s5_v1.0.0                # active model

# ──────── OPTIONAL ────────
ANTHROPIC_API_KEY=                     # if S5-30 uses Claude API; rotate monthly per FND-5
